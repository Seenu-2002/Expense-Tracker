import com.ajay.seenu.expensetracker.data.model.TransactionTypeEntity;
import com.ajay.seenu.expensetracker.data.model.AccountTypeEntity;

CREATE TABLE TransactionDetailEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    type TEXT AS TransactionTypeEntity NOT NULL,
    amount REAL NOT NULL,
    categoryId INTEGER NOT NULL,
    accountId INTEGER NOT NULL,
    toAccountId INTEGER,
    createdAt INTEGER NOT NULL,
    note TEXT,
    place TEXT,
    deletedAt INTEGER,
    FOREIGN KEY(categoryId) REFERENCES CategoryEntity(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    FOREIGN KEY(accountId) REFERENCES AccountEntity(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    FOREIGN KEY(toAccountId) REFERENCES AccountEntity(id)
        ON UPDATE CASCADE
        ON DELETE SET NULL
);
CREATE INDEX transaction_time ON TransactionDetailEntity(createdAt);
CREATE INDEX transaction_category_id ON TransactionDetailEntity(categoryId);
CREATE INDEX transaction_account_id ON TransactionDetailEntity(accountId);

CREATE TABLE CategoryEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    label TEXT NOT NULL,
    type TEXT AS TransactionTypeEntity NOT NULL,
    iconRes INTEGER NOT NULL,
    color INTEGER NOT NULL,
    UNIQUE (label, type) ON CONFLICT ABORT
);

CREATE TABLE AttachmentEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    transactionId INTEGER NOT NULL, -- Foreign key to link to the ITEM table
    name TEXT NOT NULL,
    filePath TEXT NOT NULL,
    fileType TEXT NOT NULL,
    size INTEGER NOT NULL,
    imageUri TEXT NOT NULL,
    FOREIGN KEY (transactionId) REFERENCES TransactionDetailEntity(id) ON DELETE CASCADE
);
CREATE INDEX transactionId ON AttachmentEntity(transactionId);

CREATE TABLE AccountEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    type TEXT AS AccountTypeEntity NOT NULL,
    isDefault INTEGER DEFAULT 0 NOT NULL,
    initialBalance REAL NOT NULL DEFAULT 0.0,
    UNIQUE (name, type) ON CONFLICT ABORT
);

getAllTransactions:
SELECT *
FROM TransactionDetailEntity WHERE deletedAt IS NULL ORDER BY createdAt DESC LIMIT :limit OFFSET :offset;

getTransactionsCount:
SELECT COUNT(*) FROM TransactionDetailEntity WHERE deletedAt IS NULL;

getAllTransactionsBetween:
SELECT *
FROM TransactionDetailEntity WHERE deletedAt IS NULL AND createdAt >= :startUTCValue AND createdAt <= :endUTCValue
ORDER BY createdAt DESC LIMIT :limit OFFSET :offset;

getAllTransactionsWithDetails:
SELECT
    t.id, t.type, t.amount, t.categoryId, t.accountId, t.toAccountId, t.createdAt, t.note, t.place,
    c.label AS categoryLabel, c.type AS categoryType, c.iconRes AS categoryIconRes, c.color AS categoryColor,
    a.name AS accountName, a.type AS accountType, a.isDefault AS accountIsDefault,
    ta.name AS toAccountName, ta.type AS toAccountType, ta.isDefault AS toAccountIsDefault
FROM TransactionDetailEntity t
INNER JOIN CategoryEntity c ON t.categoryId = c.id
INNER JOIN AccountEntity a ON t.accountId = a.id
LEFT JOIN AccountEntity ta ON t.toAccountId = ta.id
WHERE t.deletedAt IS NULL
ORDER BY t.createdAt DESC
LIMIT :limit OFFSET :offset;

getAllTransactionsBetweenWithDetails:
SELECT
    t.id, t.type, t.amount, t.categoryId, t.accountId, t.toAccountId, t.createdAt, t.note, t.place,
    c.label AS categoryLabel, c.type AS categoryType, c.iconRes AS categoryIconRes, c.color AS categoryColor,
    a.name AS accountName, a.type AS accountType, a.isDefault AS accountIsDefault,
    ta.name AS toAccountName, ta.type AS toAccountType, ta.isDefault AS toAccountIsDefault
FROM TransactionDetailEntity t
INNER JOIN CategoryEntity c ON t.categoryId = c.id
INNER JOIN AccountEntity a ON t.accountId = a.id
LEFT JOIN AccountEntity ta ON t.toAccountId = ta.id
WHERE t.deletedAt IS NULL AND t.createdAt >= :startUTCValue AND t.createdAt <= :endUTCValue
ORDER BY t.createdAt DESC
LIMIT :limit OFFSET :offset;

searchTransactionsBetweenWithDetails:
SELECT
    t.id, t.type, t.amount, t.categoryId, t.accountId, t.toAccountId, t.createdAt, t.note, t.place,
    c.label AS categoryLabel, c.type AS categoryType, c.iconRes AS categoryIconRes, c.color AS categoryColor,
    a.name AS accountName, a.type AS accountType, a.isDefault AS accountIsDefault,
    ta.name AS toAccountName, ta.type AS toAccountType, ta.isDefault AS toAccountIsDefault
FROM TransactionDetailEntity t
INNER JOIN CategoryEntity c ON t.categoryId = c.id
INNER JOIN AccountEntity a ON t.accountId = a.id
LEFT JOIN AccountEntity ta ON t.toAccountId = ta.id
WHERE t.deletedAt IS NULL
  AND t.createdAt >= :startUTCValue
  AND t.createdAt <= :endUTCValue
  AND (t.note LIKE :query OR t.place LIKE :query OR c.label LIKE :query OR a.name LIKE :query)
ORDER BY t.createdAt DESC
LIMIT :limit OFFSET :offset;

getAllTransactionsByType:
SELECT *
FROM TransactionDetailEntity WHERE deletedAt IS NULL AND type = :type ORDER BY createdAt DESC LIMIT :limit OFFSET :offset;

getTransaction:
SELECT *
FROM TransactionDetailEntity WHERE id = :id;

addTransaction:
INSERT INTO TransactionDetailEntity(type, amount, categoryId, accountId, toAccountId, note, createdAt, place)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateTransaction:
INSERT OR REPLACE INTO TransactionDetailEntity(id, type, amount, categoryId, accountId, toAccountId, note, createdAt, place)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getLastInsertTransactionRowId:
SELECT last_insert_rowid();

deleteAllTransactions:
DELETE FROM TransactionDetailEntity;

deleteAllTransactionsByType:
DELETE FROM TransactionDetailEntity WHERE type = :type;

softDeleteTransaction:
UPDATE TransactionDetailEntity SET deletedAt = :deletedAt WHERE id = :id AND deletedAt IS NULL;

restoreTransaction:
UPDATE TransactionDetailEntity SET deletedAt = NULL WHERE id = :id;

deleteTransaction:
DELETE FROM TransactionDetailEntity WHERE id = :id;

permanentlyDeleteTransaction:
DELETE FROM TransactionDetailEntity WHERE id = :id AND deletedAt IS NOT NULL;

purgeOldDeletedTransactions:
DELETE FROM TransactionDetailEntity WHERE deletedAt IS NOT NULL AND deletedAt < :cutoffMs;

changeCategory:
UPDATE TransactionDetailEntity SET categoryId = :newCategory WHERE categoryId = :oldCategory;

numberOfTransactionsByCategory:
SELECT COUNT(*) AS count FROM TransactionDetailEntity WHERE deletedAt IS NULL AND categoryId = :category;

getDeletedTransactionsWithDetails:
SELECT
    t.id, t.type, t.amount, t.categoryId, t.accountId, t.toAccountId, t.createdAt, t.note, t.place, t.deletedAt,
    c.label AS categoryLabel, c.type AS categoryType, c.iconRes AS categoryIconRes, c.color AS categoryColor,
    a.name AS accountName, a.type AS accountType, a.isDefault AS accountIsDefault,
    ta.name AS toAccountName, ta.type AS toAccountType, ta.isDefault AS toAccountIsDefault
FROM TransactionDetailEntity t
INNER JOIN CategoryEntity c ON t.categoryId = c.id
INNER JOIN AccountEntity a ON t.accountId = a.id
LEFT JOIN AccountEntity ta ON t.toAccountId = ta.id
WHERE t.deletedAt IS NOT NULL
ORDER BY t.deletedAt DESC
LIMIT :limit OFFSET :offset;

getDeletedTransactionsCount:
SELECT COUNT(*) FROM TransactionDetailEntity WHERE deletedAt IS NOT NULL;

getSumOfAmountByType:
SELECT SUM(amount) AS sum FROM TransactionDetailEntity WHERE deletedAt IS NULL AND type = :type;

getSumOfAmountBetweenByType:
SELECT SUM(amount) AS sum FROM TransactionDetailEntity WHERE deletedAt IS NULL AND type = :type
AND createdAt >= :startUTCValue AND createdAt <= :endUTCValue;

getOverallDataBetween:
SELECT
    COALESCE(SUM(CASE WHEN type = 'INCOME' THEN amount ELSE 0 END), 0) AS income,
    COALESCE(SUM(CASE WHEN type = 'EXPENSE' THEN amount ELSE 0 END), 0) AS expense
FROM TransactionDetailEntity
WHERE deletedAt IS NULL AND createdAt >= :startUTCValue AND createdAt <= :endUTCValue;

getAllCategories:
SELECT * FROM CategoryEntity;

getCategories:
SELECT * FROM CategoryEntity WHERE type = :type;

deleteCategory:
DELETE FROM CategoryEntity WHERE id = ?;

addCategory:
INSERT INTO CategoryEntity(label, type, iconRes, color)
VALUES (?,?, ?, ?);

getCategory:
SELECT * FROM CategoryEntity WHERE id = ?;

updateCategory:
UPDATE CategoryEntity
SET label = ?, iconRes = ?, color = ?
WHERE id = ?;

searchCategory:
SELECT * FROM CategoryEntity WHERE label = :label AND type = :type;

getTotalTransactionPerDayByTypeBetween:
SELECT createdAt, categoryId, SUM(amount) AS totalAmount FROM TransactionDetailEntity WHERE deletedAt IS NULL AND type = :type AND createdAt >= :startUTCValue AND createdAt <= :endUTCValue GROUP BY createdAt, categoryId ORDER BY createdAt DESC;

getTotalExpenseByCategoryBetween:
SELECT categoryId, SUM(amount) AS totalAmount FROM TransactionDetailEntity WHERE deletedAt IS NULL AND type = "EXPENSE" AND createdAt >= :startUTCValue AND createdAt <= :endUTCValue GROUP BY categoryId ORDER BY totalAmount DESC;

getTotalAmountByCategoryAndTypeBetween:
SELECT categoryId, SUM(amount) AS total FROM TransactionDetailEntity WHERE deletedAt IS NULL AND type = :type AND createdAt >= :startUTCValue AND createdAt <= :endUTCValue GROUP BY categoryId ORDER BY categoryId ASC;

getTotalExpenseByCategoryInPeriod:
SELECT COALESCE(SUM(amount), 0) AS totalAmount
FROM TransactionDetailEntity
WHERE
   deletedAt IS NULL
   AND (:categoryId IS NULL OR categoryId = :categoryId)
   AND createdAt >= :startDate
   AND createdAt <= :endDate
   AND type = 'EXPENSE';

getAllAttachmentsForTransaction:
SELECT * FROM AttachmentEntity WHERE transactionId = ?;

insertAttachment:
INSERT INTO AttachmentEntity (transactionId, name, filePath, fileType, size, imageUri)
VALUES (?, ?, ?, ?, ?, ?);

deleteAttachmentById:
DELETE FROM AttachmentEntity WHERE id = ?;

deleteAttachmentsByTransactionId:
DELETE FROM AttachmentEntity WHERE transactionId = ?;

getAccountsByType:
SELECT * FROM AccountEntity WHERE type = ?;

getAllAccounts:
SELECT * FROM AccountEntity;

getAccountById:
SELECT * FROM AccountEntity WHERE id = ?;

createAccount:
INSERT INTO AccountEntity (name, type, isDefault, initialBalance) VALUES (?, ?, ?, ?);

updateAccount:
UPDATE AccountEntity SET name = ?, type = ?, initialBalance = ? WHERE id = :id;

deleteAccount:
DELETE FROM AccountEntity WHERE id = ?;

getAllAccountsWithBalance:
SELECT
    a.id, a.name, a.type, a.isDefault, a.initialBalance,
    a.initialBalance + COALESCE(SUM(
        CASE
            WHEN t.type = 'INCOME' THEN t.amount
            WHEN t.type = 'EXPENSE' THEN -t.amount
            WHEN t.type = 'TRANSFER' AND t.accountId = a.id THEN -t.amount
            WHEN t.type = 'TRANSFER' AND t.toAccountId = a.id THEN t.amount
            ELSE 0
        END
    ), 0) AS balance
FROM AccountEntity a
LEFT JOIN TransactionDetailEntity t ON (t.accountId = a.id OR t.toAccountId = a.id) AND t.deletedAt IS NULL
GROUP BY a.id;

-- NOTE: BudgetEntity dates (startDate, endDate, createdAt, updatedAt) are stored in epoch SECONDS.
-- TransactionDetailEntity.createdAt is stored in epoch MILLISECONDS.
-- Spending queries that join both tables use millisecond parameters for filtering transactions.
CREATE TABLE BudgetEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    categoryId INTEGER,  -- NULL for overall budget, specific category_id for category budget
    amount REAL NOT NULL,
    periodType TEXT NOT NULL, -- 'MONTHLY', 'WEEKLY', 'YEARLY', 'CUSTOM'
    startDate INTEGER NOT NULL,
    endDate INTEGER,  -- NULL for recurring budgets, specific date for custom period
    isRecurring INTEGER NOT NULL DEFAULT 1, -- 0 for false, 1 for true
    createdAt INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updatedAt INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    isActive INTEGER NOT NULL DEFAULT 1,
    alertEnabled INTEGER NOT NULL DEFAULT 1,
    alertThresholdPercentage REAL NOT NULL DEFAULT 0.8,
    lastAlertTriggeredAt INTEGER
);

-- Index for better query performance
CREATE INDEX idx_budget_category ON BudgetEntity(categoryId);
CREATE INDEX idx_budget_active ON BudgetEntity(isActive);
CREATE INDEX idx_budget_period ON BudgetEntity(startDate, endDate);

-- Queries for Budget operations
selectAllActiveBudgets:
SELECT * FROM BudgetEntity
WHERE isActive = 1
ORDER BY createdAt DESC;

selectBudgetsByCategory:
SELECT * FROM BudgetEntity
WHERE categoryId = ? AND isActive = 1;

selectOverallBudgets:
SELECT * FROM BudgetEntity
WHERE categoryId IS NULL AND isActive = 1;

selectBudgetById:
SELECT * FROM BudgetEntity
WHERE id = ?;

selectActiveBudgetsForPeriod:
SELECT * FROM BudgetEntity
WHERE isActive = 1
AND startDate <= ?2
AND (endDate IS NULL OR endDate >= ?1);

insertBudget:
INSERT INTO BudgetEntity (name, categoryId, amount, periodType, startDate, endDate, isRecurring, alertEnabled, alertThresholdPercentage)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateBudget:
UPDATE BudgetEntity
SET name = ?, categoryId = ?, amount = ?, periodType = ?,
    startDate = ?, endDate = ?, isRecurring = ?,
    updatedAt = strftime('%s', 'now'), alertEnabled = ?, alertThresholdPercentage = ?
WHERE id = ?;

deleteBudget:
UPDATE BudgetEntity
SET isActive = 0, updatedAt = strftime('%s', 'now')
WHERE id = ?;

-- Query to get budget spending for a specific period
getBudgetSpendingForPeriod:
SELECT
    b.id,
    b.name,
    b.amount,
    b.categoryId,
    COALESCE(SUM(CASE WHEN t.type = 'EXPENSE' THEN t.amount ELSE 0 END), 0)
FROM BudgetEntity b
LEFT JOIN TransactionDetailEntity t ON (
    (b.categoryId IS NULL OR b.categoryId = t.categoryId)
    AND t.createdAt >= ?
    AND t.createdAt <= ?
    AND t.type = 'EXPENSE'
    AND t.deletedAt IS NULL
)
WHERE b.isActive = 1
AND b.id = ?
GROUP BY b.id;

updateLastAlertTime:
UPDATE BudgetEntity
SET lastAlertTriggeredAt = ?
WHERE id = ?;

getTransactionCountByAccount:
SELECT COUNT(*) AS count FROM TransactionDetailEntity WHERE deletedAt IS NULL AND accountId = ?;

changeAccount:
UPDATE TransactionDetailEntity SET accountId = :newAccount WHERE accountId = :oldAccount;

-- Fetch all active budgets with their spending aggregated in a single query
getAllActiveBudgetsWithSpending:
SELECT
    b.id,
    b.name,
    b.categoryId,
    b.amount,
    b.periodType,
    b.startDate,
    b.endDate,
    b.isRecurring,
    b.createdAt,
    b.updatedAt,
    b.isActive,
    b.alertEnabled,
    b.alertThresholdPercentage,
    b.lastAlertTriggeredAt,
    COALESCE(SUM(CASE WHEN t.type = 'EXPENSE' THEN t.amount ELSE 0 END), 0) AS spentAmount
FROM BudgetEntity b
LEFT JOIN TransactionDetailEntity t ON (
    (b.categoryId IS NULL OR b.categoryId = t.categoryId)
    AND t.createdAt >= :startDate
    AND t.createdAt <= :endDate
    AND t.type = 'EXPENSE'
    AND t.deletedAt IS NULL
)
WHERE b.isActive = 1
GROUP BY b.id
ORDER BY b.createdAt DESC;

-- Fetch active budgets relevant to a specific category (category-specific + overall) with spending
getActiveBudgetsWithSpendingForCategory:
SELECT
    b.id,
    b.name,
    b.categoryId,
    b.amount,
    b.periodType,
    b.startDate,
    b.endDate,
    b.isRecurring,
    b.createdAt,
    b.updatedAt,
    b.isActive,
    b.alertEnabled,
    b.alertThresholdPercentage,
    b.lastAlertTriggeredAt,
    COALESCE(SUM(CASE WHEN t.type = 'EXPENSE' THEN t.amount ELSE 0 END), 0) AS spentAmount
FROM BudgetEntity b
LEFT JOIN TransactionDetailEntity t ON (
    (b.categoryId IS NULL OR b.categoryId = t.categoryId)
    AND t.createdAt >= :startDate
    AND t.createdAt <= :endDate
    AND t.type = 'EXPENSE'
    AND t.deletedAt IS NULL
)
WHERE b.isActive = 1
AND (b.categoryId = :categoryId OR b.categoryId IS NULL)
GROUP BY b.id;